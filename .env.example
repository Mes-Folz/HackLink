# Copy to .env.local. Never commit real values.
# Neon pooled connection string for application queries.
DATABASE_URL=
# Neon direct/unpooled connection string for Prisma migrations.
DATABASE_URL_UNPOOLED=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Resend sender configuration for email verification. Keep the API key server-only.
RESEND_API_KEY=
EMAIL_FROM=
# Set to true only for local/staging sample content. Never seed production.
SAMPLE_SEED=false
